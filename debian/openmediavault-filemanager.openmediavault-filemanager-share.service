# Share link server of the file manager, see
# /usr/lib/openmediavault-filemanager/share_server.py. It is enabled and
# started by the FileManager RPC when share links are enabled.
[Unit]
Description=openmediavault File Manager share links
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -I -B /usr/lib/openmediavault-filemanager/share_server.py
Restart=on-failure
RestartSec=10
# Downloads appear in the audit log of the file manager.
SyslogIdentifier=omv-filemanager
RuntimeDirectory=openmediavault-filemanager-share
RuntimeDirectoryMode=0755
StateDirectory=openmediavault-filemanager-share
StateDirectoryMode=0700
UMask=0077
# The broker reads the shared files (CAP_DAC_READ_SEARCH); the HTTP
# server process changes to an unprivileged user in an empty chroot,
# which drops all capabilities.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_SYS_CHROOT
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/root -/etc/openmediavault -/var/lib/openmediavault
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service chroot
SystemCallErrorNumber=EPERM
LimitNOFILE=4096
TasksMax=128

[Install]
WantedBy=multi-user.target
