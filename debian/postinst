#!/bin/sh

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
    configure)
        # Initialize the configuration database.
        echo "Updating configuration database ..."
        omv-confdbadm create "conf.service.filemanager"

        # Rebuild the workbench so the new pages/RPC are registered.
        dpkg-trigger update-workbench

        # Restart the share link server after an upgrade, if enabled.
        if [ -d /run/systemd/system ] && systemctl --quiet is-enabled \
                openmediavault-filemanager-share.service 2>/dev/null; then
            deb-systemd-invoke try-restart \
                openmediavault-filemanager-share.service || true
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
