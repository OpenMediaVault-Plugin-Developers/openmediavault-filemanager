{
  "type": "config",
  "id": "conf.service.filemanager",
  "title": "File Manager",
  "queryinfo": {
    "xpath": "//services/filemanager",
    "iterable": false
  },
  "properties": {
    "enable": {
      "type": "boolean",
      "default": true
    },
    "readonly": {
      "type": "boolean",
      "default": false
    },
    "showhidden": {
      "type": "boolean",
      "default": true
    },
    "maxeditsize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 2
    },
    "sharedfolders": {
      "type": "string",
      "default": ""
    },
    "usetrash": {
      "type": "boolean",
      "default": true
    },
    "auditlog": {
      "type": "boolean",
      "default": true
    },
    "allowusers": {
      "type": "boolean",
      "default": false
    }
  }
}
